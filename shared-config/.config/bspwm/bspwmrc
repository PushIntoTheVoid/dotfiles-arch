#!/usr/bin/env bash

command -v bspc >/dev/null 2>&1 || exit 1

# Desktop-wide settings
bspc config window_gap 12
bspc config split_ratio 0.55
bspc config borderless_monocle true
bspc config gapless_monocle true
bspc config single_monocle false
bspc config pointer_modifier mod4

if command -v sxhkd >/dev/null 2>&1; then
    pkill -x sxhkd 2>/dev/null || true
    sxhkd &
fi

if command -v picom >/dev/null 2>&1; then
    if [[ -r "$HOME/.config/picom/picom.conf" ]]; then picom --config "$HOME/.config/picom/picom.conf" &
    else picom &
    fi
fi
if command -v dunst >/dev/null 2>&1; then dunst & fi
if command -v feh >/dev/null 2>&1 && [[ -r "$HOME/.fehbg" ]]; then
    bash "$HOME/.fehbg" &
fi
if command -v xsetroot >/dev/null 2>&1; then xsetroot -cursor_name left_ptr & fi
if command -v lxpolkit >/dev/null 2>&1; then lxpolkit &
elif command -v /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 >/dev/null 2>&1; then
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi

if [[ -x "$HOME/.config/bspwm/autostart" ]]; then
    "$HOME/.config/bspwm/autostart"
fi

if [[ -x "$HOME/.scripts/custom-autostart" ]]; then
    "$HOME/.scripts/custom-autostart" &
fi

if [[ -x "$HOME/.config/polybar/scripts/launch-polybar.sh" ]]; then
    "$HOME/.config/polybar/scripts/launch-polybar.sh" &
fi
