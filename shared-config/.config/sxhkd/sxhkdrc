# Reload sxhkd key bindings
super + Escape
	pkill -USR1 -x sxhkd

# Show the keyboard guide in Rofi; Escape closes it.
super + F1
	rofi -dmenu -i -p 'Atajos bspwm' < "$HOME/.config/bspwm/keybindings.txt"

# Applications
super + Return
	kitty

super + d
	rofi -show drun

super + e
	thunar

super + r
	rofi -show run

super + alt + t
	bash ~/.scripts/theme-swap/theme-swap.sh --rofi

# Window management
super + q
	bspc node -c

super + alt + q
	bspc quit

super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

super + {_,shift + }{Left,Down,Up,Right}
	bspc node -{f,s} {west,south,north,east}

super + {_,shift + }{h,j,k,l}
	bspc node -{f,s} {west,south,north,east}

super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}' --follow

super + bracket{left,right}
	bspc desktop -f {prev,next}.local

super + m
	bspc desktop -l next

super + ctrl + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

super + alt + {Left,Down,Up,Right}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Utilities
Print
	mkdir -p "$HOME/Pictures/Screenshots"; scrot "$HOME/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

super + shift + s
	scrot -s /tmp/screenshot.png && xclip -selection clipboard -t image/png -i /tmp/screenshot.png

ctrl + alt + w
	bash ~/.scripts/wallpaper-picker

ctrl + alt + v
	pavucontrol

super + space
	dunstctl close-all

super + shift + Escape
	dunstctl history-pop
